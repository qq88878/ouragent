# ==================== LLM 配置 ====================
# 星火大模型（比赛要求）
SPARK_APP_ID=your_spark_app_id
SPARK_API_KEY=your_spark_api_key
SPARK_API_SECRET=your_spark_api_secret
SPARK_MODEL=generalv3.5
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1

# 或者使用 OpenAI 兼容接口（DeepSeek、MIMO 等）
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# ==================== Embedding 配置 ====================
# 星火 Embedding API
EMBEDDING_API_KEY=your_spark_api_key
EMBEDDING_BASE_URL=https://spark-api-open.xf-yun.com/v1
EMBEDDING_MODEL=embedding

# 或者使用 OpenAI Embedding
# EMBEDDING_API_KEY=your_openai_key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agent_db
DB_USER=agent
DB_PASSWORD=agent_password

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== 安全配置 ====================
SECRET_KEY=your-secret-key-change-in-production
AGENT_SERVICE_KEY=internal-agent-key-2024

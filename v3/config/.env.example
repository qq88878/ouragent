# ============================================================
# Agent Service - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================================

# --- LLM 配置 ---
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# 星火大模型 (LLM_PROVIDER=spark 时使用)
# SPARK_APP_ID=your-app-id
# SPARK_API_KEY=your-api-key
# SPARK_API_SECRET=your-api-secret
# SPARK_MODEL=generalv3.5
# SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1

# --- Embedding 配置 ---
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

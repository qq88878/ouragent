# Secrets 配置示例
# 复制此文件为 secrets.yaml 并修改密码
# cp secrets.yaml.example secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: edu-secrets
  namespace: edu-agent
type: Opaque
stringData:
  # MySQL
  MYSQL_ROOT_PASSWORD: change-me-root-password
  # JWT
  JWT_SECRET: change-me-jwt-secret-at-least-256-bits
  # 服务间密钥
  AGENT_SERVICE_KEY: change-me-service-key
  # LLM
  LLM_API_KEY: change-me-llm-api-key

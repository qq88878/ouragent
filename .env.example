# ============================================================
# Docker Compose 环境变量配置示例
# 复制此文件为 .env 并修改对应的值
# cp .env.example .env
# ============================================================

# ==================== MySQL ====================
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=edu

# ==================== Java 后端 ====================
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx512m
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=change-me-root-password
REDIS_HOST=redis
AGENT_SERVICE_URL=http://agent-service:8000
AGENT_SERVICE_KEY=change-me-service-key
AGENT_TIMEOUT=10000

# ==================== 邮件 (邮箱验证) ====================
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-auth-code
APP_BASE_URL=http://localhost

# ==================== Python Agent ====================
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
DB_NAME=edu
DB_PORT=3306
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_PORT=6379
REDIS_PASSWORD=
SECRET_KEY=change-me-secret-key

# ==================== JWT ====================
JWT_SECRET=change-me-jwt-secret-at-least-256-bits

# ==================== LLM (Python Agent) ====================
# 提供商: spark (星火) / openai (OpenAI 兼容接口)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# 星火大模型 (LLM_PROVIDER=spark 时使用)
# SPARK_APP_ID=your-app-id
# SPARK_API_KEY=your-api-key
# SPARK_API_SECRET=your-api-secret

# ==================== Embedding ====================
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ==================== 其他 ====================
TZ=Asia/Shanghai

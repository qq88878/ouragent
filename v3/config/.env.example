# ============================================================
# Agent Service - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# --- 应用配置 ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- LLM 配置 ---
# 提供商: spark (星火) / openai (OpenAI兼容接口)
LLM_PROVIDER=openai

# OpenAI 兼容接口配置（支持 OpenAI、DeepSeek、MIMO 等）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# 星火大模型配置（LLM_PROVIDER=spark 时使用）
# SPARK_APP_ID=your-app-id
# SPARK_API_KEY=your-api-key
# SPARK_API_SECRET=your-api-secret
# SPARK_MODEL=generalv3.5
# SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1

# --- Embedding 配置 ---
# 不配置则使用本地 TF-IDF（性能较差但无需API）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# --- Redis 配置 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- 安全配置 ---
# 生产环境必须修改以下密钥！
SECRET_KEY=change-this-to-a-random-string
AGENT_SERVICE_KEY=change-this-to-a-random-string

# --- CORS 配置 ---
# 逗号分隔的允许源
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Agent 配置 ---
AGENT_DEFAULT_MEMORY_SIZE=100
AGENT_MAX_MEMORY_SIZE=1000

# ============================================================
# Docker Compose 环境变量配置示例
# 复制此文件为 .env 并修改对应的值
# ============================================================

# ==================== MySQL (Java后端数据库) ====================
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=edu_agent
MYSQL_USER=edu_agent
MYSQL_PASSWORD=edu_agent_password

# ==================== PostgreSQL (Agent服务数据库) ====================
POSTGRES_DB=agent_db
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_password

# ==================== Redis缓存 ====================
REDIS_PASSWORD=

# ==================== Java后端配置 ====================
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx512m
DB_HOST=mysql
DB_USER=edu_agent
DB_PASSWORD=edu_agent_password
REDIS_HOST=redis
AGENT_SERVICE_URL=http://agent-service:8000
AGENT_TIMEOUT=10000

# ==================== Python Agent服务配置 ====================
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# PostgreSQL连接 (Agent服务)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=agent_db
DB_USER=agent
DB_PASSWORD=agent_password

# Redis连接
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== JWT密钥 (Java后端) ====================
JWT_SECRET=change-this-in-production-use-at-least-256-bits

# ==================== 服务间密钥 ====================
AGENT_SERVICE_KEY=internal-agent-key-2024

# ==================== LLM 配置 (Python Agent) ====================
# 选择 LLM 提供商: spark（星火）/ openai（OpenAI 或兼容接口）
LLM_PROVIDER=openai

# 星火大模型（如果 LLM_PROVIDER=spark）
# SPARK_APP_ID=your-app-id
# SPARK_API_KEY=your-api-key
# SPARK_API_SECRET=your-api-secret
# SPARK_MODEL=generalv3.5

# OpenAI 兼容接口（如果 LLM_PROVIDER=openai）
# LLM_API_KEY=your-api-key
# LLM_MODEL=gpt-3.5-turbo
# LLM_BASE_URL=https://api.openai.com/v1

# ==================== 其他配置 ====================
# 时区
TZ=Asia/Shanghai
